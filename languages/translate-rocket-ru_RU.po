msgstr "Стиль"

msgid "Layout"
msgstr "Вид"

msgid "Inline (horizontal)"
msgstr "В строку (горизонтально)"

msgid "List (vertical)"
msgstr "Список (вертикально)"

msgid "Dropdown"
msgstr "Выпадающий список"

msgid "Scrollable bar (arrows, for many languages)"
msgstr "Прокручиваемая полоса (со стрелками, для многих языков)"

msgid "Show"
msgstr "Показать"

msgid "Flag + name"
msgstr "Флаг + название"

msgid "Flag only"
msgstr "Только флаг"

msgid "Name only"
msgstr "Только название"

msgid "Current language"
msgstr "Текущий язык"

msgid "Hide"
msgstr "Скрыть"

msgid "Language names"
msgstr "Названия языков"

msgid "Show in English (otherwise native)"
msgstr "Показывать по-английски (иначе на родном языке)"

msgid "On mobile"
msgstr "На мобильных"

msgid "Same as desktop"
msgstr "Как на компьютере"

msgid "Flags only"
msgstr "Только флаги"

msgid "Hidden"
msgstr "Скрыто"

msgid "On small screens (e.g. with a burger menu): show only flags, or hide it."
msgstr "На маленьких экранах (напр. с меню-гамбургером): показывать только флаги или скрыть."

msgid "Open dropdown"
msgstr "Открытие списка"

msgid "On click"
msgstr "По клику"

msgid "On mouse over"
msgstr "При наведении мыши"

msgid "Only for the “Dropdown” layout."
msgstr "Только для вида «Выпадающий список»."

msgid "Arrow"
msgstr "Стрелка"

msgid "Show an arrow that flips when the dropdown opens"
msgstr "Показывать стрелку, которая переворачивается при открытии"

msgid "Flag corners"
msgstr "Углы флага"

msgid "Top-left corner"
msgstr "Левый верхний угол"

msgid "Top-right corner"
msgstr "Правый верхний угол"

msgid "Same value for all corners"
msgstr "Одно значение для всех углов"

msgid "Bottom-left corner"
msgstr "Левый нижний угол"

msgid "Bottom-right corner"
msgstr "Правый нижний угол"

msgid "Rounding (px) per corner. The centre link keeps them equal."
msgstr "Скругление (px) для каждого угла. Значок в центре делает их одинаковыми."

msgid "Width"
msgstr "Ширина"

msgid "Auto"
msgstr "Авто"

msgid "Small"
msgstr "Маленький"

msgid "Medium"
msgstr "Средняя"

msgid "Large"
msgstr "Большой"

msgid "Custom (px)"
msgstr "Своё значение (px)"

msgid "Colours"
msgstr "Цвета"

msgid "Presets:"
msgstr "Заготовки:"

msgid "Minimal"
msgstr "Минимальный"

msgid "Dark"
msgstr "Тёмная"

msgid "Gold"
msgstr "Золотая"

msgid "Ocean"
msgstr "Океан"

msgid "Glass"
msgstr "Стекло"

msgid "Pill"
msgstr "Капсула"

msgid "Soft"
msgstr "Мягкая"

msgid "Sunset"
msgstr "Закат"

msgid "Forest"
msgstr "Лес"

msgid "Midnight"
msgstr "Полночь"

msgid "Candy"
msgstr "Карамель"

msgid "Outline"
msgstr "Контур"

msgid "Paper"
msgstr "Бумага"

msgid "Neon"
msgstr "Неон"

msgid "Frost"
msgstr "Иней"

msgid "Smooth"
msgstr "Плавная"

msgid "Text colour"
msgstr "Цвет текста"

msgid "Text colour (hover)"
msgstr "Цвет текста (при наведении)"

msgid "Background colour"
msgstr "Цвет фона"

msgid "Menu background (dropdown)"
msgstr "Фон меню (выпадающий список)"

msgid "Background colour (hover)"
msgstr "Цвет фона (при наведении)"

msgid "Border colour"
msgstr "Цвет рамки"

msgid "Corner radius"
msgstr "Скругление углов"

msgid "Shadow"
msgstr "Тень"

msgid "None"
msgstr "Нет"

msgid "Light"
msgstr "Слабая"

msgid "Strong"
msgstr "Сильная"

msgid "Open animation"
msgstr "Анимация открытия"

msgid "How the dropdown menu appears when opened."
msgstr "Как появляется выпадающее меню при открытии."

msgid "Fade"
msgstr "Затухание"

msgid "Slide down"
msgstr "Выезд сверху вниз"

msgid "Scale"
msgstr "Масштаб"

msgid "Hover effect"
msgstr "Эффект при наведении"

msgid "A subtle effect on each language when the visitor hovers it."
msgstr "Лёгкий эффект для каждого языка при наведении курсора."

msgid "Lift"
msgstr "Подъём"

msgid "Grow"
msgstr "Увеличение"

msgid "Underline"
msgstr "Подчёркивание"

msgid "Font"
msgstr "Шрифт"

msgid "Theme default"
msgstr "Как в теме"

msgid "Text style"
msgstr "Стиль текста"

msgid "Bold"
msgstr "Жирный"

msgid "UPPERCASE"
msgstr "ПРОПИСНЫЕ"

msgid "Font size"
msgstr "Размер шрифта"

msgid "e.g. 14px. Leave empty to inherit from your theme."
msgstr "напр. 14px. Оставьте пустым, чтобы взять из темы."

msgid "Flag / text divider"
msgstr "Разделитель флага и текста"

msgid "Shown only when both flag and name are visible."
msgstr "Показывается, только когда видны и флаг, и название."

msgid "Background opacity"
msgstr "Прозрачность фона"

msgid "Affects only the background — the flag and text stay fully visible."
msgstr "Влияет только на фон — флаг и текст остаются полностью видимыми."

msgid "Placement"
msgstr "Размещение"

msgid "Choose one: either place the switcher yourself with the shortcode / block, or let the plugin float it for you — not both."
msgstr "Выберите одно: либо разместите переключатель сами шорткодом или блоком, либо пусть плагин сделает его плавающим — но не оба варианта."

msgid "Where to show the switcher"
msgstr "Где показывать переключатель"

msgid "Manual — I add it with the shortcode / block"
msgstr "Вручную — добавлю сам шорткодом или блоком"

msgid "Floating — bottom right"
msgstr "Плавающий — справа внизу"

msgid "Floating — bottom left"
msgstr "Плавающий — слева внизу"

msgid "Floating — top right"
msgstr "Плавающий — справа вверху"

msgid "Floating — top left"
msgstr "Плавающий — слева вверху"

msgid "Floating — custom position (X / Y)"
msgstr "Плавающий — своё положение (X / Y)"

msgid "X (from left)"
msgstr "X (слева)"

msgid "Y (from top)"
msgstr "Y (сверху)"

msgid "Use % or px, e.g. 10% / 20px."
msgstr "Используйте % или px, напр. 10% / 20px."

msgid "Add it where you want with the [translaterocket_switcher] shortcode or the “Language switcher” block."
msgstr "Добавьте его куда нужно шорткодом [translaterocket_switcher] или блоком «Переключатель языков»."

msgid "Save switcher"
msgstr "Сохранить переключатель"

msgid "Live preview"
msgstr "Живой предпросмотр"

msgid "Preview on:"
msgstr "Предпросмотр на:"

msgid "White"
msgstr "Белая"

msgid "Light grey"
msgstr "Светло-серая"

msgid "Brand"
msgstr "Бренд"

msgid "Teal"
msgstr "Бирюзовая"

msgid "Photo"
msgstr "Фото"

msgid "Custom background"
msgstr "Свой фон"

msgid "Colours update live; layout and labels update after you save."
msgstr "Цвета меняются сразу, вид и подписи — после сохранения."

msgid "Translation memory"
msgstr "Память переводов"

msgid "Every string detected across your whole site, in one place. Search a word to find — and fix — it everywhere at once."
msgstr "Все строки со всего сайта в одном месте. Найдите слово поиском — и исправьте его сразу везде."

msgid "Add a target language first in TranslateRocket settings."
msgstr "Сначала добавьте язык перевода в настройках TranslateRocket."

msgid "Saved."
msgstr "Сохранено."

msgid "Removed %d unused string."
msgstr "Удалена %d неиспользуемая строка."

msgid "AI translation failed — check the AI provider and key, or the daily limit."
msgstr "Перевод с ИИ не удался — проверьте поставщика и ключ или дневной лимит."

msgid "AI translated %d strings."
msgstr "ИИ перевёл %d строк."

msgid "Language:"
msgstr "Язык:"

msgid "Delete %d strings (and their translations) not seen on any page in the last 30 days? Run “Scan site for text” first so the pages you still have count as seen."
msgstr "Удалить %d строк (и их переводы), не встречавшихся ни на одной странице за последние 30 дней? Сначала запустите «Сканировать сайт на текст», чтобы существующие страницы были учтены."

msgid "🧹 Remove %d unused strings"
msgstr "🧹 Удалить %d неиспользуемых строк"

msgid "Removes strings from pages that no longer exist (deleted or changed). Tip: run the site scan first, otherwise pages you simply haven’t opened recently could be counted as unused."
msgstr "Удаляет строки со страниц, которых больше нет (удалены или изменены). Совет: сначала запустите сканирование, иначе страницы, которые вы просто давно не открывали, сочтутся неиспользуемыми."

msgid "Search source or translation…"
msgstr "Искать в оригинале или переводе…"

msgid "Only missing"
msgstr "Только непереведённые"

msgid "Search"
msgstr "Поиск"

msgid "%d string"
msgstr "%d строка"

msgid "Translate %d missing with AI"
msgstr "Перевести %d непереведённых с ИИ"

msgid "Fills every still-missing string for this language using the active AI provider."
msgstr "Заполняет все непереведённые строки этого языка активным поставщиком ИИ."

msgid "Set up an AI provider on the AI page to bulk-translate the missing strings."
msgstr "Настройте поставщика ИИ на странице ИИ, чтобы перевести все непереведённые строки сразу."

msgid "Save changes"
msgstr "Сохранить изменения"

msgid "Translate this page with AI"
msgstr "Перевести эту страницу с ИИ"

msgid "Configure an AI provider first in %s."
msgstr "Сначала настройте поставщика ИИ в %s."

msgid "Languages"
msgstr "Языки"

msgid "AI"
msgstr "ИИ"

msgid "Copies"
msgstr "Копии"

msgid "Help"
msgstr "Помощь"

msgid "Free, AI-powered translation for WordPress"
msgstr "Бесплатный перевод для WordPress с помощью ИИ"

msgid "Unlimited languages · Visual editor · SEO-ready"
msgstr "Без ограничения языков · Визуальный редактор · Готов к SEO"

msgid "TranslateRocket is 100% free. Support development to keep it free — supporters get priority support & custom help."
msgstr "TranslateRocket полностью бесплатен. Поддержите разработку, чтобы он таким и остался — сторонники получают приоритетную поддержку и помощь."

msgid "Support the project"
msgstr "Поддержать проект"

msgid "Add at least one target language first."
msgstr "Сначала добавьте хотя бы один язык перевода."

msgid "%d page updated."
msgstr "Обновлена %d страница."

msgid "Detaching a page makes a fast, independent copy (a real, cache-friendly page you edit in WordPress). “Back to strings” reattaches it to the source — the copy is kept (paused), not deleted — so you can re-detach later and keep your edits."
msgstr "Отделение создаёт быструю независимую копию (настоящую страницу WordPress, удобную для кэширования). «Назад к строкам» снова связывает её с оригиналом — копия сохраняется (приостановлена), а не удаляется, — поэтому позже её можно отделить снова вместе с правками."

msgid "Create independent copy"
msgstr "Создать независимую копию"

msgid "Back to strings (reattach)"
msgstr "Назад к строкам (связать снова)"

msgid "Delete copy"
msgstr "Удалить копию"

msgid "Apply to selected"
msgstr "Применить к выбранным"

msgid "Page"
msgstr "Страница"

msgid "Status (%s)"
msgstr "Статус (%s)"

msgid "(no title)"
msgstr "(без заголовка)"

msgid "Independent copy active"
msgstr "Независимая копия включена"

msgid "Edit copy"
msgstr "Изменить копию"

msgid "Copy paused (reattached)"
msgstr "Копия приостановлена (снова связана)"

msgid "String translation"
msgstr "Перевод строк"

msgid "Free keys end in “:fx”. Use “Check usage” below for your live monthly quota."
msgstr "Бесплатные ключи заканчиваются на «:fx». Текущий месячный расход — по кнопке «Проверить расход» ниже."

msgid "Pay-as-you-go (needs a few dollars of credit). gpt-4o-mini is cheap and good."
msgstr "Оплата по факту (нужно несколько долларов на счету). gpt-4o-mini дёшев и хорош."

msgid "Google Cloud Translation API key (requires a Google Cloud project with billing)."
msgstr "Ключ API Google Cloud Translation (нужен проект Google Cloud с оплатой)."

msgid "Has a free tier — create a key in Google AI Studio at no cost."
msgstr "Есть бесплатный тариф — создайте ключ в Google AI Studio бесплатно."

msgid "Pay-as-you-go on the Anthropic API (separate from a Claude.ai subscription)."
msgstr "Оплата по факту через API Anthropic (отдельно от подписки Claude.ai)."

msgid "AI settings saved."
msgstr "Настройки ИИ сохранены."

msgid "Provider &amp; keys"
msgstr "Поставщик и ключи"

msgid "Choose which AI service does the translating and paste its API key. You pay the provider directly — TranslateRocket takes nothing."
msgstr "Выберите, какой сервис ИИ будет переводить, и вставьте его ключ API. Вы платите поставщику напрямую — TranslateRocket не берёт ничего."

msgid "You bring your own API key. Text is sent only to the provider you choose, only when you ask to translate."
msgstr "Вы используете свой ключ API. Текст отправляется только выбранному поставщику и только когда вы запрашиваете перевод."

msgid "Active provider"
msgstr "Активный поставщик"

msgid "The service used when you click “Translate with AI”. Leave on “None” to translate only by hand or copy-paste."
msgstr "Сервис, который используется при нажатии «Перевести с ИИ». Оставьте «Нет», чтобы переводить только вручную или копированием."

msgid "— None —"
msgstr "— Нет —"

msgid "Active"
msgstr "Активен"

msgid "Key set"
msgstr "Ключ задан"

msgid "API key"
msgstr "Ключ API"

msgid "Your secret key from this provider. Stored on your site only, and sent to the provider when translating."
msgstr "Ваш секретный ключ от этого поставщика. Хранится только на вашем сайте и отправляется поставщику при переводе."

msgid "Quota this cycle: %1$s of %2$s characters (%3$d%%)."
msgstr "Расход за цикл: %1$s из %2$s символов (%3$d%%)."

msgid "Exhausted — translations fall back to the next provider in your chain."
msgstr "Исчерпано — переводы переходят к следующему поставщику в цепочке."

msgid "Almost used up."
msgstr "Почти исчерпано."

msgid "Get a %s API key ↗"
msgstr "Получить ключ API для %s ↗"

msgid "Fallback priority"
msgstr "Приоритет замены"

msgid "Optional. Give two or more providers a priority to build a fallback chain: bulk and automatic translation try priority 1 first, and switch to priority 2, 3… whenever one runs out of credit or its key is refused. Leave on “—” to keep a provider out of the chain."
msgstr "Необязательно. Задайте приоритет двум и более поставщикам, чтобы построить цепочку замены: массовый и автоматический перевод сначала пробуют приоритет 1 и переходят к 2, 3… как только у одного кончается счёт или ключ отклоняется. Оставьте «—», чтобы исключить поставщика из цепочки."

msgid "—"
msgstr "—"

msgid "1 = try first. Providers with no priority are used only as the active one above."
msgstr "1 — пробовать первым. Поставщики без приоритета используются только как активный выше."

msgid "Model"
msgstr "Модель"

msgid "Optional. The specific AI model to use (e.g. gpt-4o-mini). Leave empty for a sensible default."
msgstr "Необязательно. Конкретная модель ИИ (напр. gpt-4o-mini). Оставьте пустым для разумного значения по умолчанию."

msgid "Pick a suggested model or type your own."
msgstr "Выберите модель из списка или введите свою."

msgid "Load available models"
msgstr "Загрузить доступные модели"

msgid "Queries this provider with your key and lists the exact models it can use right now."
msgstr "Обращается к поставщику с вашим ключом и показывает, какие модели доступны прямо сейчас."

msgid "Check usage"
msgstr "Проверить расход"

msgid "Usage &amp; limits"
msgstr "Расход и ограничения"

msgid "Protect your API spend: cap how many characters are sent to the AI each day, and keep crawlers from triggering paid translation."
msgstr "Берегите бюджет на API: ограничьте число символов, отправляемых ИИ за день, и не давайте роботам запускать платный перевод."

msgid "Daily character limit"
msgstr "Дневной лимит символов"

msgid "A safety cap on how many characters can be sent to the AI per day. When the cap is reached, AI translation stops until tomorrow (manual and copy-paste still work). 0 means no limit."
msgstr "Защитный предел на число символов, отправляемых ИИ за сутки. При достижении перевод с ИИ останавливается до завтра (ручной перевод и копирование работают). 0 — без ограничений."

msgid "0 = unlimited. Used today: %s characters."
msgstr "0 — без ограничений. Сегодня использовано: %s символов."

msgid "Usage this period"
msgstr "Расход за период"

msgid "How much AI translation you’ve used since the counter started — to keep an eye on your provider spend. Reset it whenever you like, or set a monthly reset day below to match your billing."
msgstr "Сколько перевода с ИИ израсходовано с момента запуска счётчика — чтобы следить за тратами у поставщика. Сбрасывайте когда угодно или задайте ниже день ежемесячного сброса под ваш расчётный период."

msgid "characters"
msgstr "символов"

msgid "requests"
msgstr "запросов"

msgid "(since %s)"
msgstr "(с %s)"

msgid "Reset the usage counter to zero?"
msgstr "Обнулить счётчик расхода?"

msgid "Reset counter"
msgstr "Сбросить счётчик"

msgid "Saved by reuse"
msgstr "Сэкономлено на повторах"

msgid "When the same text appears again — on another page, as an image alt, as an interface string, or as a glossary term — TranslateRocket copies the translation you already have instead of paying the AI to translate it again. This is what that translation memory has kept in your pocket."
msgstr "Когда тот же текст встречается снова — на другой странице, в альт-теге, в интерфейсе или в глоссарии — TranslateRocket берёт уже готовый перевод вместо того, чтобы снова платить ИИ. Вот сколько сберегла эта память переводов."

msgid "strings translated for free"
msgstr "строк переведено бесплатно"

msgid "Estimate at %s list prices — your real saving depends on your plan."
msgstr "Оценка по прайсу %s — реальная экономия зависит от вашего тарифа."

msgid "Monthly reset day"
msgstr "День ежемесячного сброса"

msgid "Day of the month the usage counter restarts on its own (e.g. your provider’s billing date). 0 = never reset automatically."
msgstr "День месяца, когда счётчик расхода обнуляется сам (напр. дата счёта у поставщика). 0 — никогда не обнулять автоматически."

msgid "0 = manual only. 1–31 = reset on that day each month (shorter months use their last day)."
msgstr "0 — только вручную. 1–31 — сброс в этот день каждый месяц (в коротких месяцах — в последний день)."

msgid "Crawlers"
msgstr "Поисковые роботы"

msgid "Search engines and other bots visit your pages constantly. With auto-translation on, those visits could trigger paid AI calls for pages no real visitor asked for. Turn this on to ignore known bots, so only real visitors (and you) ever trigger AI translation."
msgstr "Поисковые системы и другие роботы заходят на страницы постоянно. При включённом автопереводе такие визиты могут вызывать платные обращения к ИИ для страниц, которые никто не запрашивал. Включите это, чтобы известные роботы игнорировались и перевод запускали только живые посетители (и вы)."

msgid "Don’t let bots / crawlers trigger AI translation"
msgstr "Не давать ботам и поисковым роботам запускать перевод с ИИ"

msgid "Only matters with auto-translation enabled; recommended on."
msgstr "Имеет значение только при включённом автопереводе; рекомендуется включить."

msgid "Save AI settings"
msgstr "Сохранить настройки ИИ"

msgid "Bulk auto-translate"
msgstr "Массовый автоперевод"

msgid "Fill in every missing string for a language at once with the active AI provider. You can refine any result by hand afterwards."
msgstr "Заполнить все непереведённые строки языка сразу активным поставщиком ИИ. Любой результат потом можно поправить вручную."

msgid "Translate every missing string for a language with the active provider."
msgstr "Перевести все непереведённые строки языка активным поставщиком."

msgid "Language"
msgstr "Язык"

msgid "Progress"
msgstr "Прогресс"

msgid "Missing"
msgstr "Не переведено"

msgid "Translate %d missing"
msgstr "Перевести %d непереведённых"

msgid "Exclusions saved."
msgstr "Исключения сохранены."

msgid "Keep parts of your site in the original language. One entry per line."
msgstr "Оставить часть сайта на исходном языке. По одной записи в строке."

msgid "Pages (URL paths)"
msgstr "Страницы (пути URL)"

msgid "Paths that are never translated. Use * as a wildcard, e.g. /checkout/* or /my-account/*."
msgstr "Пути, которые никогда не переводятся. * заменяет любую часть, напр. /checkout/* или /my-account/*."

msgid "Elements (CSS selectors)"
msgstr "Элементы (CSS-селекторы)"

msgid "Elements left untranslated. Simple selectors only: a tag (code), a class (.notranslate) or an id (#brand)."
msgstr "Элементы, которые не переводятся. Только простые селекторы: тег (code), класс (.notranslate) или идентификатор (#brand)."

msgid "Words &amp; phrases"
msgstr "Слова и выражения"

msgid "Exact strings that must stay as-is — brand or product names, etc. Never collected, translated or sent to an AI."
msgstr "Точные строки, которые должны остаться как есть — названия брендов, продуктов и т. п. Никогда не собираются, не переводятся и не отправляются ИИ."

msgid "Glossary"
msgstr "Глоссарий"

msgid "Force a fixed translation for a term, everywhere it appears. One “source = translation” per line. Overrides AI/manual translations for an exact match — great for brand wording, product names or terms that must read the same across the whole site."
msgstr "Закрепить перевод термина везде, где он встречается. По одной паре «оригинал = перевод» в строке. При точном совпадении имеет приоритет над переводом ИИ и ручным — удобно для формулировок бренда, названий продуктов и терминов, которые должны звучать одинаково по всему сайту."

msgid "Add a target language first (Languages tab) to define glossary terms."
msgstr "Сначала добавьте язык перевода (вкладка «Языки»), чтобы задать термины."

msgid "Save exclusions"
msgstr "Сохранить исключения"

msgid "PHP version"
msgstr "Версия PHP"

msgid "Running PHP %s (7.4 or newer required)."
msgstr "Работает на PHP %s (нужна версия 7.4 или новее)."

msgid "PHP extensions"
msgstr "Расширения PHP"

msgid "All required extensions are present (dom, mbstring, libxml, json)."
msgstr "Все нужные расширения на месте (dom, mbstring, libxml, json)."

msgid "Missing extensions: %s. Ask your host to enable them."
msgstr "Не хватает расширений: %s. Попросите хостинг включить их."

msgid "WordPress version"
msgstr "Версия WordPress"

msgid "Running WordPress %s."
msgstr "Работает на WordPress %s."

msgid "Database tables"
msgstr "Таблицы базы данных"

msgid "All TranslateRocket tables exist."
msgstr "Все таблицы TranslateRocket на месте."

msgid "Missing: %s. Deactivate and reactivate TranslateRocket to recreate them."
msgstr "Не хватает: %s. Отключите и снова включите TranslateRocket, чтобы создать их заново."

msgid "Source: %1$s · %2$d target language(s) configured."
msgstr "Исходный язык: %1$s · настроено языков перевода: %2$d."

msgid "No target languages yet. Add at least one on the Languages tab."
msgstr "Языков перевода пока нет. Добавьте хотя бы один на вкладке «Языки»."

msgid "Permalinks"
msgstr "Постоянные ссылки"

msgid "Pretty permalinks are on — language URLs like /it/ will work."
msgstr "Человекопонятные ссылки включены — адреса вида /it/ будут работать."

msgid "Plain permalinks are on. Language URLs like /it/ need pretty permalinks: go to Settings → Permalinks and choose anything but “Plain”."
msgstr "Включены простые постоянные ссылки. Для адресов вида /it/ нужны человекопонятные: зайдите в «Настройки → Постоянные ссылки» и выберите любой вариант, кроме «Простые»."

msgid "AI provider"
msgstr "Поставщик ИИ"

msgid "Active provider: %s."
msgstr "Активный поставщик: %s."

msgid "No AI provider configured (optional — you can still translate by hand or with the Google links). Add a key on the AI tab."
msgstr "Поставщик ИИ не настроен (это необязательно — можно переводить вручную или по ссылкам Google). Добавьте ключ на вкладке ИИ."

msgid "Log cleared."
msgstr "Журнал очищен."

msgid "A quick health check of your setup, plus anything TranslateRocket has flagged — so nothing fails silently."
msgstr "Быстрая проверка вашей установки и всё, что отметил TranslateRocket — чтобы ничего не ломалось незаметно."

msgid "System checks"
msgstr "Проверки системы"

msgid "Provider connection test"
msgstr "Проверка связи с поставщиком"

msgid "Sends one short word to each configured provider to confirm the key works right now."
msgstr "Отправляет одно короткое слово каждому настроенному поставщику, чтобы проверить ключ."

msgid "No provider keys saved yet. Add one on the AI tab."
msgstr "Ключи поставщиков ещё не сохранены. Добавьте ключ на вкладке ИИ."

msgid "Test connection"
msgstr "Проверить соединение"

msgid "Recent issues"
msgstr "Последние проблемы"

msgid "Errors and warnings TranslateRocket recorded, including ones from background tasks."
msgstr "Ошибки и предупреждения, записанные TranslateRocket, в том числе из фоновых задач."

msgid "Nothing to report — no issues logged."
msgstr "Сообщать не о чем — проблем не зафиксировано."

msgid "When"
msgstr "Когда"

msgid "Level"
msgstr "Уровень"

msgid "Area"
msgstr "Область"

msgid "Message"
msgstr "Сообщение"

msgid "Clear log"
msgstr "Очистить журнал"

msgid "Testing…"
msgstr "Проверка…"

msgid "You’re all set!"
msgstr "Всё готово!"

msgid "Your languages are configured. Now translate your first page — it takes a minute."
msgstr "Языки настроены. Теперь переведите первую страницу — это займёт минуту."

msgid "Translate my homepage now"
msgstr "Перевести главную сейчас"

msgid "Open the translations list"
msgstr "Открыть список переводов"

msgid "Go to settings"
msgstr "Перейти к настройкам"

msgid "TranslateRocket™ setup"
msgstr "Настройка TranslateRocket™"

msgid "Translation"
msgstr "Перевод"

msgid "What languages?"
msgstr "Какие языки?"

msgid "Pick the language your site is written in, then the languages to translate it into."
msgstr "Выберите язык, на котором написан сайт, а затем языки для перевода."

msgid "My site is written in:"
msgstr "Мой сайт написан на:"

msgid "Translate into:"
msgstr "Переводить на:"

msgid "How do you want to translate?"
msgstr "Как вы хотите переводить?"

msgid "You can let an AI do a first pass automatically, or translate by hand — you can always change this later."
msgstr "Можно доверить черновой перевод ИИ или переводить вручную — это всегда можно изменить позже."

msgid "Use an AI provider"
msgstr "Использовать поставщика ИИ"

msgid "Paste your own API key. You pay the provider directly — TranslateRocket takes nothing."
msgstr "Вставьте свой ключ API. Вы платите поставщику напрямую — TranslateRocket не берёт ничего."

msgid "Paste your API key"
msgstr "Вставьте свой ключ API"

msgid "Translate manually"
msgstr "Перевести вручную"

msgid "Type translations yourself, or use the free one-click Google links. No key needed."
msgstr "Вводите переводы сами или пользуйтесь бесплатными ссылками Google в один клик. Ключ не нужен."

msgid "Show the language switcher"
msgstr "Показывать переключатель языков"

msgid "How should visitors switch language? You can fine-tune the look later on the Switcher tab."
msgstr "Как посетители будут менять язык? Внешний вид настроите позже на вкладке «Переключатель»."

msgid "Floating button"
msgstr "Плавающая кнопка"

msgid "A small switcher that floats in a corner on every page. Easiest — nothing else to do."
msgstr "Небольшой переключатель, плавающий в углу на каждой странице. Самый простой вариант — больше ничего не нужно."

msgid "I’ll place it myself"
msgstr "Размещу сам"

msgid "Use the block “Language Switcher”, or the shortcode %s, wherever you like."
msgstr "Используйте блок «Переключатель языков» или шорткод %s там, где вам удобно."

msgid "← Back"
msgstr "← Назад"

msgid "Next →"
msgstr "Далее →"

msgid "Finish & start translating"
msgstr "Завершить и начать перевод"

msgid "Languages &amp; general"
msgstr "Языки и общие настройки"

msgid "Quick start"
msgstr "Быстрый старт"

msgid "Choose your site language and the languages to translate into — right below."
msgstr "Ниже выберите язык сайта и языки, на которые переводить."

msgid "Translate: add an AI key in %s for one-click translation, or translate by hand on each page."
msgstr "Перевод: добавьте ключ ИИ в %s для перевода в один клик или переводите вручную на каждой странице."

msgid "Add a language switcher: place the [translaterocket_switcher] shortcode or block, or enable the floating one in %s."
msgstr "Добавьте переключатель языков: вставьте шорткод [translaterocket_switcher] или блок либо включите плавающий в %s."

msgid "Settings saved."
msgstr "Настройки сохранены."

msgid "Site language (source)"
msgstr "Язык сайта (исходный)"

msgid "The language your existing content is written in. It stays at the site root with no URL prefix and is never translated."
msgstr "Язык, на котором написано ваше содержимое. Он остаётся в корне сайта без префикса и никогда не переводится."

msgid "The language your content is written in. It stays at the site root (no URL prefix)."
msgstr "Язык, на котором написано содержимое. Он остаётся в корне сайта (без префикса в адресе)."

msgid "Translate into"
msgstr "Переводить на"

msgid "The languages visitors can switch to. Each gets its own URL prefix (e.g. /it/) and its own set of translations."
msgstr "Языки, на которые могут переключаться посетители. У каждого свой префикс в адресе (напр. /it/) и свой набор переводов."

msgid "Pick the languages you want to add. Each gets its own URL prefix, e.g. /en/."
msgstr "Выберите языки для добавления. У каждого будет свой префикс в адресе, напр. /en/."

msgid "Your source language (%s) isn’t listed here — it’s the language you translate from. Change it in “Site language (source)” above."
msgstr "Вашего исходного языка (%s) здесь нет — это язык, с которого вы переводите. Измените его выше, в поле «Язык сайта (исходный)»."

msgid "Custom language"
msgstr "Свой язык"

msgid "Not in the list? Add your own: a short code (used in the URL, e.g. /la/), a name, and a flag picked from the list. After saving it appears among the languages above — tick it to enable."
msgstr "Нет в списке? Добавьте свой: короткий код (используется в адресе, напр. /la/), название и флаг из списка. После сохранения язык появится выше — отметьте его, чтобы включить."

msgid "remove"
msgstr "удалить"

msgid "Code"
msgstr "Код"

msgid "e.g. la"
msgstr "напр. la"

msgid "Name"
msgstr "Название"

msgid "e.g. Latina"
msgstr "напр. Latina"

msgid "Flag"
msgstr "Флаг"

msgid "Choose…"
msgstr "Выбрать…"

msgid "No flag (globe)"
msgstr "Без флага (глобус)"

msgid "Upload your own…"
msgstr "Загрузить своё…"

msgid "+ Add language"
msgstr "+ Добавить язык"

msgid "Enter a code (it becomes the URL prefix, e.g. /la/) and a name, then pick a flag: choose one from the list, upload your own image (for a region or language with no country flag), or leave the 🌐 globe."
msgstr "Введите код (он станет префиксом адреса, напр. /la/) и название, затем выберите флаг: возьмите его из списка, загрузите своё изображение (для региона или языка без государственного флага) или оставьте 🌐."

msgid "Choose a flag image"
msgstr "Выберите изображение флага"

msgid "Use this image"
msgstr "Использовать это изображение"

msgid "Who sees the translations"
msgstr "Кто видит переводы"

msgid "Preview mode: keep the translated site visible to administrators only, e.g. to review an import from another plugin on the real pages before going live. Visitors keep seeing the default language (language URLs redirect, the switcher is hidden and no hreflang/sitemap signals are sent). Switch back to \"Everyone\" to publish instantly."
msgstr "Режим предпросмотра: переведённый сайт виден только администраторам — например, чтобы проверить импорт из другого плагина на настоящих страницах перед публикацией. Посетители видят язык по умолчанию (языковые адреса перенаправляют, переключатель скрыт, сигналы hreflang и карты сайта не отправляются). Верните «Все», чтобы опубликовать сразу."

msgid "Everyone — translations are live"
msgstr "Все — переводы опубликованы"

msgid "Administrators only — preview mode, visitors keep seeing the default language"
msgstr "Только администраторы — режим предпросмотра, посетители видят язык по умолчанию"

msgid "SEO meta"
msgstr "SEO-мета"

msgid "Also translate the SEO title and meta description — the text shown in Google results and the browser tab."
msgstr "Переводить также SEO-заголовок и мета-описание — текст в результатах Google и во вкладке браузера."

msgid "Translate SEO title and meta description tags"
msgstr "Переводить SEO-заголовок и мета-описание"

msgid "Interface language"
msgstr "Язык интерфейса"

msgid "Show menus, buttons and theme/plugin labels in the visitor's language using WordPress' own official translations — no AI, nothing to manage. The needed language packs are downloaded automatically. Turn off to leave the interface in the site language."
msgstr "Показывать меню, кнопки и подписи тем и плагинов на языке посетителя, используя официальные переводы самого WordPress — без ИИ и без настройки. Нужные языковые пакеты скачиваются автоматически. Отключите, чтобы интерфейс остался на языке сайта."

msgid "Use WordPress' own translations for the interface"
msgstr "Использовать для интерфейса собственные переводы WordPress"

msgid "Auto-redirect"
msgstr "Автоперенаправление"

msgid "On their first visit, send visitors to the version matching their browser language (remembered with a cookie, only once). Never redirects search engines or logged-in users."
msgstr "При первом заходе направлять посетителей на версию, совпадающую с языком их браузера (запоминается в cookie, один раз). Поисковые системы и вошедших пользователей никогда не перенаправляет."

msgid "Redirect new visitors to their browser language"
msgstr "Направлять новых посетителей на язык их браузера"

msgid "Page cache"
msgstr "Кэш страниц"

msgid "Store the finished translated HTML of each page so repeat visits skip the on-the-fly translation — about 2× faster on repeat visits (e.g. ~0.55s → ~0.29s in our test). Only anonymous visitors are served from the cache, it skips dynamic pages (cart, checkout, account), and it clears automatically whenever you change a translation, edit a page, or update settings. On by default — turn it off only if you already use a page-cache plugin (e.g. WP Rocket), which already caches each language’s URL."
msgstr "Сохранять готовый переведённый HTML каждой страницы, чтобы при повторных заходах не переводить заново — примерно вдвое быстрее (в нашем тесте ~0,55 с → ~0,29 с). Из кэша обслуживаются только неавторизованные посетители, динамические страницы (корзина, оформление заказа, личный кабинет) пропускаются, а кэш очищается сам при изменении перевода, правке страницы или смене настроек. Включено по умолчанию — отключайте, только если уже используете плагин кэширования страниц (напр. WP Rocket), который кэширует адрес каждого языка."

msgid "Cache translated pages for anonymous visitors"
msgstr "Кэшировать переведённые страницы для гостей"

msgid "Powered by badge"
msgstr "Значок «Powered by»"

msgid "Show a small \"Powered by TranslateRocket\" badge with the logo at the bottom of your site. Off by default and entirely optional — a nice way to support the free plugin. You can also place it anywhere with the [translaterocket_poweredby] shortcode."
msgstr "Показывать внизу сайта небольшой значок «Powered by TranslateRocket» с логотипом. По умолчанию выключено и совершенно необязательно — приятный способ поддержать бесплатный плагин. Его можно разместить где угодно шорткодом [translaterocket_poweredby]."

msgid "Show a \"Powered by TranslateRocket\" badge in the footer"
msgstr "Показывать значок «Powered by TranslateRocket» в подвале"

