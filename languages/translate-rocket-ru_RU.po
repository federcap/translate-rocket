msgstr "Вернуть исходный текст (напр. если метки [1] [2] испортились) и перевести заново."

msgid "Markers like [1] [2] are formatting (bold, links). Keep them where they are."
msgstr "Метки вида [1] [2] — это форматирование (жирный, ссылки). Оставьте их на месте."

msgid "⚠ Keep all the [1] [2] markers so the bold/links can be restored."
msgstr "⚠ Сохраните все метки [1] [2], чтобы жирный шрифт и ссылки восстановились."

msgid "Already translated"
msgstr "Уже переведено"

msgid "Saved"
msgstr "Сохранено"

msgid "Done"
msgstr "Готово"

msgid "Click any text to translate it"
msgstr "Нажмите на любой текст, чтобы перевести его"

msgid "Switch this page back to runtime translation? Your independent copy is kept (paused), not deleted — you can re-create it later to get your edits back."
msgstr "Вернуть страницу к переводу на лету? Независимая копия сохранится (приостановлена), а не удалится — позже её можно пересоздать и вернуть правки."

msgid "Delete this independent copy for good? Its edits will be lost and the page goes back to runtime translation."
msgstr "Удалить эту независимую копию навсегда? Правки будут потеряны, страница вернётся к переводу на лету."

msgid "%s is your source language — pick a language to translate into:"
msgstr "%s — ваш исходный язык. Выберите язык, на который переводить:"

msgid "Switch to %s"
msgstr "Переключить на %s"

msgid "Visibility"
msgstr "Видимость"

msgid "SEO"
msgstr "SEO"

msgid "Delete this independent copy"
msgstr "Удалить эту независимую копию"

msgid "The source page changed after this copy was made — re-create it to pull in the changes (the copy's edits are lost), or keep editing the copy."
msgstr "Исходная страница изменилась после создания копии — пересоздайте её, чтобы подтянуть изменения (правки копии будут потеряны), или продолжайте править копию."

msgid "Source changed"
msgstr "Оригинал изменён"

msgid "This page is served from an independent copy."
msgstr "Эта страница отдаётся из независимой копии."

msgid "Independent copy"
msgstr "Независимая копия"

msgid "Back to strings"
msgstr "Назад к строкам"

msgid "Reactivate the independent copy (your edits are restored)."
msgstr "Снова включить независимую копию (ваши правки вернутся)."

msgid "Reactivate copy"
msgstr "Снова включить копию"

msgid "Detach this page into an independent, fully-editable copy, pre-filled with the current translation."
msgstr "Отделить страницу в независимую, полностью редактируемую копию с уже готовым переводом."

msgid "https://…"
msgstr "https://…"

msgid "Custom message shown instead of the page."
msgstr "Своё сообщение вместо страницы."

msgid "Language visibility for this page"
msgstr "Видимость этой страницы по языкам"

msgid "Choose what happens when this page is viewed in each language — translate it, redirect, show a message, or 404."
msgstr "Выберите, что происходит при открытии страницы на каждом языке — перевод, перенаправление, сообщение или 404."

msgid "Save visibility"
msgstr "Сохранить видимость"

msgid "The homepage has no slug — its address is just the language prefix."
msgstr "У главной страницы нет слага — её адрес состоит только из префикса языка."

msgid "The page address in this language, e.g. /%s/about-us/. Leave empty to keep the original."
msgstr "Адрес страницы на этом языке, напр. /%s/about-us/. Оставьте пустым, чтобы сохранить исходный."

msgid "The short summary under the title in Google results."
msgstr "Краткое описание под заголовком в результатах Google."

msgid "SEO for this page"
msgstr "SEO этой страницы"

msgid "What search engines see in %s: the translated URL slug, the page title and the meta description."
msgstr "Что видят поисковые системы на языке %s: переведённый слаг, заголовок страницы и мета-описание."

msgid "Save SEO"
msgstr "Сохранить SEO"

msgid "Not detected on this page yet."
msgstr "Пока не найдено на этой странице."

msgid "No AI provider configured."
msgstr "Поставщик ИИ не настроен."

msgid "Translation failed."
msgstr "Не удалось перевести."

msgid "Could not create the copy."
msgstr "Не удалось создать копию."

msgid "Polylang is not configured."
msgstr "Polylang не настроен."

msgid "TranslatePress is not configured."
msgstr "TranslatePress не настроен."

msgid "WPML is not configured."
msgstr "WPML не настроен."

msgid "DeepL: monthly character quota exhausted — it resets at the start of your DeepL billing cycle."
msgstr "DeepL: месячный лимит символов исчерпан — он обновится в начале вашего расчётного периода DeepL."

msgid "Automatic Google translation is turned off."
msgstr "Автоматический перевод через Google отключён."

msgid "Google Translate stopped responding while translating into %s."
msgstr "Google Переводчик перестал отвечать при переводе на %s."

msgid "Google Translate stopped responding (it may be rate-limiting). Some strings were translated — try again in a moment for the rest."
msgstr "Google Переводчик перестал отвечать (возможно, ограничение частоты). Часть строк переведена — повторите попытку чуть позже для остальных."

msgid "No AI provider is configured. Add an API key first."
msgstr "Поставщик ИИ не настроен. Сначала добавьте ключ API."

msgid "Daily AI character limit reached. Raise it in AI settings or wait until tomorrow."
msgstr "Достигнут дневной лимит символов. Увеличьте его в настройках ИИ или подождите до завтра."

msgid "Daily AI character limit reached."
msgstr "Достигнут дневной лимит символов для ИИ."

msgid "AI translation failed (→ %s)."
msgstr "Перевод с ИИ не удался (→ %s)."

msgid "%1$s is unavailable (%2$s) — falling back to the next provider."
msgstr "%1$s недоступен (%2$s) — переходим к следующему поставщику."

msgid "Language Switcher"
msgstr "Переключатель языков"

msgid "Let visitors switch language (TranslateRocket)."
msgstr "Разрешить посетителям менять язык (TranslateRocket)."

msgid "Switcher settings"
msgstr "Настройки переключателя"

msgid "TranslateRocket has translated %s strings on this site, for free. It has no paid version: reviews are the only thing that helps other people find it. Would you leave one?"
msgstr "TranslateRocket перевёл на этом сайте %s строк — бесплатно. Платной версии нет: отзывы — единственное, что помогает другим его найти. Не оставите ли вы отзыв?"

msgid "Something is wrong instead"
msgstr "Наоборот, что-то не так"

msgid "Border"
msgstr "Рамка"

msgid "No border at all"
msgstr "Без рамки"

msgid "Removes the border instead of colouring it. The colour above is then ignored."
msgstr "Убирает рамку, а не закрашивает её. Цвет выше в этом случае не используется."

msgid "Flag + code (EN, IT…)"
msgstr "Флаг + код (EN, IT…)"

msgid "Code only (EN, IT…)"
msgstr "Только код (EN, IT…)"

msgid "House style"
msgstr "Стиль вашего бренда"

msgid "Extra instruction for the AI"
msgstr "Дополнительная инструкция для ИИ"

msgid "An extra instruction sent with every AI translation, so the wording sounds like you rather than like a dictionary. Tone, formality, words to keep in the original — anything the model should know about your brand."
msgstr "Дополнительная инструкция, которая отправляется с каждым переводом, чтобы текст звучал как ваш, а не как словарная статья. Тон, степень формальности, слова, которые нужно оставить как есть, — всё, что модели стоит знать о вашем бренде."

msgid "Optional, up to %d characters. Sent with every batch, so keep it short. It never overrides the rules that keep translations lined up with your text."
msgstr "Необязательно, до %d символов. Отправляется с каждой партией, поэтому пишите коротко. Она никогда не отменяет правила, благодаря которым перевод соответствует вашему тексту."

msgid "e.g. We are a family-run guesthouse. Keep it warm and informal, use \"tu\" in Italian, and never translate the name Villa Aurora."
msgstr "Например: Мы — семейный гостевой дом. Тон тёплый и неформальный, обращение на «ты», а название Villa Aurora не переводить."

msgid "Appearance on small screens (when shown): show only flags, or hide it."
msgstr "Вид на маленьких экранах (когда переключатель показан): только флаги или скрыть."

msgid "Desktop and mobile"
msgstr "Компьютер и телефон"

msgid "Desktop only"
msgstr "Только компьютер"

msgid "Mobile only"
msgstr "Только телефон"

msgid "Only the AI models can follow this: OpenAI, Claude and Gemini. DeepL and Google Translate are translation APIs with no prompt of their own, so they ignore it."
msgstr "Следовать ей могут только модели ИИ: OpenAI, Claude и Gemini. DeepL и Google Translate — это API перевода без собственного промпта, поэтому они её игнорируют."

msgid "Show on"
msgstr "Показывать на"

msgid "Which screen sizes show this switcher. Make one profile “Desktop only” and another “Mobile only” to design a different language menu for each (breakpoint 783px). The live preview above always shows the desktop appearance."
msgstr "На каких размерах экрана показывать этот переключатель. Сделайте один профиль «Только компьютер», а второй «Только телефон», чтобы оформить для каждого своё языковое меню (граница 783px). Предпросмотр выше всегда показывает вид на компьютере."

msgid "WooCommerce emails"
msgstr "Письма WooCommerce"

msgid "Your provider right now is %s, so this instruction will be ignored until you switch to one of those."
msgstr "Сейчас у вас провайдер %s, поэтому эта инструкция будет игнорироваться, пока вы не перейдёте на один из тех."

msgid "You’ve been translating with TranslateRocket for a while now. It’s free forever, and it stays maintained either way — if it saved you a paid plugin, a donation is a nice way to say thanks."
msgstr "Вы переводите с TranslateRocket уже некоторое время. Он бесплатен навсегда и будет поддерживаться в любом случае — если он избавил вас от платного плагина, пожертвование это приятный способ сказать спасибо."

msgid "Chrome and Edge on a computer can translate on the device itself. It costs nothing, needs no account, and the text never leaves this machine. Quality is below DeepL and the AI models, and it works through one phrase at a time — so it is the quickest way to get a translated site today, not the best one you can have."
msgstr "Chrome и Edge на компьютере умеют переводить прямо на устройстве. Это ничего не стоит, не требует учётной записи, и текст никогда не покидает эту машину. Качество ниже, чем у DeepL и моделей ИИ, и идёт по одной фразе: это самый быстрый способ получить переведённый сайт сегодня, а не самый лучший из возможных."

msgid "Could not read the translations."
msgstr "Не удалось прочитать переводы."

msgid "Done — %d strings translated in this browser."
msgstr "Готово — в этом браузере переведено строк: %d."

msgid "Downloading the language model — this happens once…"
msgstr "Загружается языковая модель — это происходит один раз…"

msgid "No language given."
msgstr "Язык не указан."

msgid "Not allowed."
msgstr "Не разрешено."

msgid "Nothing left to translate in this language."
msgstr "На этом языке переводить больше нечего."

msgid "Nothing to store."
msgstr "Нечего сохранять."

msgid "Preparing…"
msgstr "Подготовка…"

msgid "Reload the page to see the new totals."
msgstr "Перезагрузите страницу, чтобы увидеть новые итоги."

msgid "Set up an AI provider on the AI page to bulk-translate the missing strings — or use your browser below, which needs no key."
msgstr "Чтобы перевести недостающие строки пачкой, настройте провайдера на странице ИИ — или возьмите браузер ниже, ему не нужен ключ."

msgid "Stop"
msgstr "Остановить"

msgid "Stopped."
msgstr "Остановлено."

msgid "The browser translator stopped with an error."
msgstr "Переводчик браузера остановился с ошибкой."

msgid "The translator built into Chrome and Edge only works over a secure connection. Your admin is on plain http, so it cannot be used here."
msgstr "Переводчик, встроенный в Chrome и Edge, работает только по защищённому соединению. Ваша админка на обычном http, поэтому здесь им воспользоваться нельзя."

msgid "Translate %d missing in this browser"
msgstr "Перевести %d недостающих в этом браузере"

msgid "Translate with your browser — no API key"
msgstr "Перевести своим браузером — без ключа API"

msgid "Translating %1$d of %2$d…"
msgstr "Переводится %1$d из %2$d…"

msgid "You can add an API provider later for better quality — what you translate here is kept and never translated again."
msgstr "Позже можно добавить провайдера с API ради качества: то, что вы переведёте здесь, сохранится и не будет переведено заново."

msgid "Your browser has no built-in translator for %s."
msgstr "В вашем браузере нет встроенного переводчика для языка %s."

msgid "Open the copy &amp; paste tool"
msgstr "Открыть копирование и вставку"

msgid "Translate without an API key"
msgstr "Перевести без ключа API"

msgid "Your browser has no translator of its own — Chrome and Edge on a computer do. You can still work without a key: copy the missing strings out, run them through any translator you like, and paste the result back."
msgstr "В вашем браузере нет собственного переводчика — в Chrome и Edge на компьютере он есть. Работать без ключа всё равно можно: скопируйте недостающие строки, прогоните их через любой переводчик и вставьте результат обратно."

msgid "Ask for help"
msgstr "Попросить помощи"

msgid "Attach the report above (recommended — it usually saves a round of questions)"
msgstr "Приложить отчёт выше (рекомендуется — обычно экономит один круг вопросов)"

msgid "Check your provider and key"
msgstr "Проверьте провайдера и ключ"

msgid "Copied — now paste it into your message."
msgstr "Скопировано — теперь вставьте это в своё сообщение."

msgid "Copy the report"
msgstr "Скопировать отчёт"

msgid "Copy the report below and paste it into your message: it says which versions you are on and what these checks found. Nothing is sent anywhere on its own — you copy it, you decide where it goes. It never contains your API keys."
msgstr "Скопируйте отчёт ниже и вставьте его в своё сообщение: он говорит, какие у вас версии и что нашли эти проверки. Сам по себе он никуда не отправляется — вы его копируете, вы решаете, куда он пойдёт. Ваши ключи API в него не попадают никогда."

msgid "Could not reach the support site from here. Your host may be blocking outgoing requests — you can still copy the report and write from the browser."
msgstr "Отсюда не удалось связаться с сайтом поддержки. Возможно, ваш хостинг блокирует исходящие запросы — вы всё равно можете скопировать отчёт и написать из браузера."

msgid "DeepL refused with \"quota exceeded\", but your account still reports %1$s of %2$s characters used. That combination means the key itself is blocked, not the allowance: DeepL does this when the account has no verified payment method. Check your account on deepl.com/account."
msgstr "DeepL ответил «квота исчерпана», но ваш аккаунт по-прежнему сообщает: использовано %1$s из %2$s символов. Такое сочетание означает, что заблокирован сам ключ, а не квота: DeepL делает так, когда в аккаунте нет подтверждённого способа оплаты. Проверьте свой аккаунт на deepl.com/account."

msgid "DeepL: the monthly character allowance is used up. It resets at the start of your DeepL billing cycle."
msgstr "DeepL: месячный лимит символов исчерпан. Он обнуляется в начале вашего расчётного периода DeepL."

msgid "Everything is translated"
msgstr "Всё переведено"

msgid "Give it a subject first."
msgstr "Сначала укажите тему."

msgid "Give the message a subject, even a short one."
msgstr "Дайте сообщению тему, пусть даже короткую."

msgid "I need an email address to answer you."
msgstr "Мне нужен адрес электронной почты, чтобы вам ответить."

msgid "In a few words, what is wrong?"
msgstr "В двух словах: что не так?"

msgid "It did not go through."
msgstr "Отправить не удалось."

msgid "Leave this field empty"
msgstr "Оставьте это поле пустым"

msgid "Needs an API key — set one up in %s, or use your browser below (free)."
msgstr "Нужен ключ API — настройте его в %s или используйте ниже свой браузер (бесплатно)."

msgid "No API key for now"
msgstr "Пока без ключа API"

msgid "Open a topic on WordPress.org"
msgstr "Открыть тему на WordPress.org"

msgid "Or open the support site"
msgstr "Или открыть сайт поддержки"

msgid "Or write to me from here. Nothing leaves your site until you press Send, and what gets sent is exactly what you can read on this page — no keys, no page content, no visitor data."
msgstr "Или напишите мне отсюда. Ничего не покидает ваш сайт, пока вы не нажмёте «Отправить», и уходит ровно то, что вы читаете на этой странице — никаких ключей, никакого содержимого страниц, никаких данных посетителей."

msgid "Send to TranslateRocket support"
msgstr "Отправить в поддержку TranslateRocket"

msgid "Sending from here is not available on this install."
msgstr "Отправка отсюда на этой установке недоступна."

msgid "Sending…"
msgstr "Отправка…"

msgid "Sent — your ticket is #%d. My answer arrives by email."
msgstr "Отправлено — ваш запрос № %d. Мой ответ придёт по электронной почте."

msgid "Start with %s — pick your languages and you are translating."
msgstr "Начните с %s — выберите языки, и вы уже переводите."

msgid "Subject"
msgstr "Тема"

msgid "Technical report"
msgstr "Технический отчёт"

msgid "Tell me a little more — what you did, and what happened instead."
msgstr "Расскажите чуть подробнее — что вы делали и что произошло вместо этого."

msgid "That email address does not look right — without it I cannot answer you."
msgstr "Этот адрес почты выглядит неправильно — без него я не смогу вам ответить."

msgid "The AI translation could not run"
msgstr "Перевод с помощью ИИ не удалось запустить"

msgid "The support site refused the message. Please copy the report and write from the browser instead."
msgstr "Сайт поддержки отклонил сообщение. Скопируйте отчёт и напишите из браузера."

msgid "This is where my answer goes. It is used for nothing else."
msgstr "Именно сюда придёт мой ответ. Больше он ни для чего не используется."

msgid "This site is not reachable from the internet — it looks like a local or staging install. To be sure a ticket is genuine, the support site has to call your site back once, and it cannot do that here. Copy the report and write from the support page instead."
msgstr "Этот сайт недоступен из интернета — похоже на локальную или тестовую установку. Чтобы убедиться, что запрос настоящий, сайт поддержки должен один раз обратиться к вашему сайту, а здесь он этого не может. Скопируйте отчёт и напишите со страницы поддержки."

msgid "To be sure a ticket really comes from a WordPress site and not from a spam robot, the support site calls your site back once. This install is local or private, so it cannot be reached from the outside. Copy the report above and write from the support page — it gets to the same place."
msgstr "Чтобы убедиться, что запрос действительно пришёл с сайта WordPress, а не от спам-робота, сайт поддержки один раз обращается к вашему сайту. Эта установка локальная или закрытая, поэтому снаружи до неё не достучаться. Скопируйте отчёт выше и напишите со страницы поддержки — он попадёт туда же."

msgid "Translate all %d missing with AI"
msgstr "Перевести с ИИ все %d недостающих"

msgid "Translate by hand, or let Chrome and Edge translate the whole site for free from the Translations page — the text never leaves your computer. You can add a key later at any time."
msgstr "Переводите вручную или дайте Chrome и Edge бесплатно перевести весь сайт со страницы «Переводы» — текст никогда не покидает ваш компьютер. Ключ можно добавить позже, когда захотите."

msgid "Translate only this page with AI"
msgstr "Перевести с ИИ только эту страницу"

msgid "What happened"
msgstr "Что случилось"

msgid "What you were doing, what you expected, and what happened instead."
msgstr "Что вы делали, чего ожидали и что произошло вместо этого."

msgid "Write a little more about what happened."
msgstr "Напишите чуть подробнее о том, что случилось."

msgid "You just sent one. Give it a few minutes before sending another — I read them all."
msgstr "Вы только что отправили один. Подождите несколько минут перед следующим — я читаю все."

msgid "Your email"
msgstr "Ваша электронная почта"

msgid "Your name"
msgstr "Ваше имя"

msgid "or translate in this browser, free and without a key"
msgstr "или переведите в этом браузере, бесплатно и без ключа"

msgid "the 1-minute setup"
msgstr "настройка за минуту"

msgid "Chrome and Edge on a computer can translate on the device itself: it costs nothing and the text never leaves your machine. Quality is below the AI models."
msgstr "Chrome и Edge на компьютере умеют переводить прямо на устройстве: это ничего не стоит, и текст не покидает вашу машину. Качество ниже, чем у моделей ИИ."

msgid "Translate everything in this browser — no key"
msgstr "Перевести всё в этом браузере — без ключа"

msgid "Updating the totals…"
msgstr "Обновляю итоги…"

msgid "Translate in this browser"
msgstr "Перевести в этом браузере"

msgid "Everyone who helps out is named on the Contributors page."
msgstr "Все, кто помогает, названы на странице Contributors."

msgid "See who they are"
msgstr "Посмотрите, кто это"

msgid "Online: your visitors see this language. Click to hide it while you work on it."
msgstr "Онлайн: посетители видят этот язык. Нажмите, чтобы скрыть его, пока вы над ним работаете."

msgid "Offline: only you see this language. Click to publish it."
msgstr "Офлайн: этот язык видите только вы. Нажмите, чтобы опубликовать его."

msgid "online"
msgstr "онлайн"

msgid "offline"
msgstr "офлайн"

msgid "Published, or still being translated?"
msgstr "Опубликован или ещё переводится?"

msgid "A language kept offline is invisible to visitors: it is left out of the language switcher, out of your sitemap and out of the hreflang tags, and anyone landing on one of its URLs is sent to your default language. You keep working on it normally — and you can see it on the real pages, because whoever can preview still sees everything. Put it online when you are happy with it."
msgstr "Язык, оставленный офлайн, невидим для посетителей: он не попадает ни в переключатель языков, ни в карту сайта, ни в теги hreflang, а тот, кто откроет один из его адресов, попадёт на язык по умолчанию. Вы спокойно продолжаете над ним работать — и видите его на настоящих страницах, потому что у кого есть предпросмотр, тот по-прежнему видит всё. Опубликуйте его, когда будете довольны."

msgid "Add a language today, publish it when it is ready. Nothing half-translated ever reaches your visitors or Google."
msgstr "Добавьте язык сегодня, опубликуйте, когда он будет готов. Ничего наполовину переведённого не попадёт ни к посетителям, ни в Google."

msgid "nothing collected yet"
msgstr "пока ничего не собрано"

msgid "(no alt text)"
msgstr "(нет alt-текста)"

msgid "(empty)"
msgstr "(пусто)"

msgid "Alt text"
msgstr "Alt-текст"

msgid "Change the photo"
msgstr "Заменить фото"

msgid "Edit"
msgstr "Изменить"

msgid "Social title (Open Graph)"
msgstr "Заголовок для соцсетей (Open Graph)"

msgid "The headline people see when the page is shared on Facebook, LinkedIn or WhatsApp."
msgstr "Заголовок, который видят при публикации страницы в Facebook, LinkedIn или WhatsApp."

msgid "Social description (Open Graph)"
msgstr "Описание для соцсетей (Open Graph)"

msgid "The text under that headline in the shared preview."
msgstr "Текст под этим заголовком в превью при публикации."

msgid "Title for X / Twitter"
msgstr "Заголовок для X / Twitter"

msgid "Used when the page is shared on X."
msgstr "Используется при публикации страницы в X."

msgid "Description for X / Twitter"
msgstr "Описание для X / Twitter"

msgid "The summary in the X preview card."
msgstr "Краткое описание в карточке предпросмотра X."

msgid "Alt text of the shared image"
msgstr "Alt-текст изображения при публикации"

msgid "Describes the preview image for people using a screen reader."
msgstr "Описывает изображение предпросмотра для тех, кто пользуется программой чтения с экрана."

msgid "Alt text of the X image"
msgstr "Alt-текст изображения в X"

msgid "Describes the preview image on X."
msgstr "Описывает изображение предпросмотра в X."

msgid "Site name in shares"
msgstr "Название сайта при публикации"

msgid "The name of your site as it appears in the shared preview."
msgstr "Название вашего сайта в превью при публикации."

msgid "Meta keywords"
msgstr "Meta keywords"

msgid "Google has ignored these since 2009, but some other engines and directories still read them."
msgstr "Google игнорирует их с 2009 года, но некоторые другие поисковики и каталоги их ещё читают."

msgid "Images on this page"
msgstr "Изображения на этой странице"

msgid "The alt text is what search engines read instead of the picture. Click a line to jump to that photo in the page and edit it."
msgstr "Alt-текст — это то, что поисковики читают вместо картинки. Нажмите на строку, чтобы перейти к этому фото на странице и изменить его."

msgid "Other HTML attributes"
msgstr "Другие атрибуты HTML"

msgid "Titles, placeholders and ARIA labels: invisible on screen, but read by search engines and screen readers."
msgstr "Title, placeholder и ARIA-метки: на экране их не видно, но их читают поисковики и программы чтения с экрана."

msgid "Everything search engines read in %s, in order: the address, the title and description, the social preview, then the images and attributes inside the page."
msgstr "Всё, что поисковики читают на языке %s, по порядку: адрес, заголовок и описание, превью для соцсетей, затем изображения и атрибуты внутри страницы."

msgid "A language you add now starts offline: nobody sees it while you translate it. Flip its switch to green when it is ready."
msgstr "Язык, который вы добавляете сейчас, начинается офлайн: пока вы его переводите, его никто не видит. Переведите его переключатель на зелёный, когда он будет готов."

msgid "%d page changed since TranslateRocket last read it."
msgid_plural "%d pages changed since TranslateRocket last read them."
msgstr[0] "%d страница изменилась с тех пор, как TranslateRocket её прочитал."
msgstr[1] "%d страницы изменились с тех пор, как TranslateRocket их прочитал."
msgstr[2] "%d страниц изменились с тех пор, как TranslateRocket их прочитал."

msgid "Any new text on them has not been detected yet, so it is not in your list of strings to translate — and on the translated pages it is still showing in your source language."
msgstr "Новый текст на них ещё не обнаружен, поэтому его нет в списке строк для перевода — а на переведённых страницах он по-прежнему показывается на исходном языке."

msgid "Scan them now"
msgstr "Просканировать их сейчас"

msgid "⚠ Not saved — your site refused the request. Your text is still here: try again."
msgstr "⚠ Не сохранено: ваш сайт отклонил запрос. Текст никуда не делся — попробуйте ещё раз."

msgid "⚠ Your site did not answer. The text is still here — check your connection, then try again."
msgstr "⚠ Ваш сайт не ответил. Текст никуда не делся — проверьте соединение и попробуйте снова."

#: src/Frontend/VisualEditor.php
msgid "Or translate it in ChatGPT or Gemini"
msgstr "Или переведите в ChatGPT или Gemini"

#: src/Frontend/VisualEditor.php
msgid "Copy with a translation prompt"
msgstr "Скопировать с промптом для перевода"

#: src/Frontend/VisualEditor.php
msgid "Copied — paste it into the chat"
msgstr "Скопировано — вставьте в чат"

#: src/Frontend/VisualEditor.php
msgid "How does this work?"
msgstr "Как это работает?"

#: src/Frontend/VisualEditor.php
msgid "The button copies the text of this page together with a translation prompt written for your site: your two languages, the words you never translate, your glossary and your house style. The prompt asks the AI to give every numbered line back with the same number and to leave the [1] [2] markers exactly where they are, which is what lets the translation be put back in place. Paste it into the chat, copy the reply with the copy button of its code block, and paste it in box 2 below."
msgstr "Кнопка копирует текст этой страницы вместе с промптом для перевода, составленным для вашего сайта: ваши два языка, слова, которые вы никогда не переводите, ваш глоссарий и ваш стиль. Промпт просит ИИ вернуть каждую пронумерованную строку с тем же номером и оставить маркеры [1] [2] точно на своих местах — именно это позволяет вернуть перевод на место. Вставьте его в чат, скопируйте ответ кнопкой копирования в его блоке кода и вставьте в поле 2 ниже."

#: src/MenuLanguages.php
msgid "Show in"
msgstr "Показывать на"

