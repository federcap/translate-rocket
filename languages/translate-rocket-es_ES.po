msgstr "desactivado: ya hay otra caché de páginas activa en este sitio"

#: src/Admin/Admin.php
msgid "on"
msgstr "activado"

#: src/Admin/Admin.php
msgid "the day your plan renews; 0 if you use only free engines"
msgstr "el día en que se renueva tu plan; 0 si solo usas motores gratuitos"

#: src/Admin/Farewell.php
#, php-format
msgid "I agree to be contacted about this problem only. The e-mail is deleted after 6 months, and never used for anything else (%s)."
msgstr "Acepto que me contacten solo por este problema. El correo se borra a los 6 meses y nunca se usa para otra cosa (%s)."

#: src/Admin/Farewell.php
msgid "Keep it active and get help"
msgstr "Mantenerlo activo y recibir ayuda"

#: src/Admin/Farewell.php
msgid "Leave your e-mail and we will contact you to solve it (optional):"
msgstr "Deja tu correo y te contactaremos para resolverlo (opcional):"

#: src/Admin/Farewell.php
msgid "Try the Simple view: three steps"
msgstr "Prueba la vista Simple: tres pasos"

#: src/Admin/Farewell.php
msgid "Wait a moment: we fix it for you, free, usually the same day."
msgstr "Espera un momento: lo arreglamos por ti, gratis, normalmente el mismo día."

#: src/Admin/Farewell.php
msgid "privacy policy"
msgstr "política de privacidad"

#: src/Admin/SearchPage.php
