msgstr "في القائمة، العدسة تأخذ أقل مساحة؛ وفي أسفل الصفحة، الحقل أوضح."

#: src/Admin/SearchPage.php
msgid "In my phone menu (burger)"
msgstr "في قائمة الهاتف (البرغر)"

#: src/Admin/SearchPage.php
msgid "Languages & general"
msgstr "اللغات والعام"

#: src/Admin/SearchPage.php
