msgstr "إزالة كل المدرجة"

msgid "Check again"
msgstr "التحقق مجددًا"

msgid "…and %d more: remove or keep these, then check again."
msgstr "…و%d أخرى: أزل هذه أو أبقِها، ثم تحقق مجددًا."

msgid "broken characters"
msgstr "أحرف تالفة"

msgid "not written in this language’s alphabet"
msgstr "غير مكتوبة بأبجدية هذه اللغة"

