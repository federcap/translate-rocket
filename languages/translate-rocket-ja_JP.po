msgstr "背景色"

msgid "Menu background (dropdown)"
msgstr "メニューの背景 (ドロップダウン)"

msgid "Background colour (hover)"
msgstr "背景色 (ホバー時)"

msgid "Border colour"
msgstr "枠線の色"

msgid "Corner radius"
msgstr "角の丸み"

msgid "Shadow"
msgstr "影"

