msgstr "左下"

msgid "Bottom-right corner"
msgstr "右下"

msgid "Rounding (px) per corner. The centre link keeps them equal."
msgstr "角ごとの丸み (px)。中央のリンクを押すとすべて同じ値になります。"

msgid "Width"
msgstr "幅"

msgid "Auto"
msgstr "自動"

