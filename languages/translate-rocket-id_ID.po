#: src/Admin/Admin.php:1299
msgid "Import CSV"
msgstr "Impor CSV"

#: src/Admin/Admin.php:1303
msgid "Export & import (TMX)"
msgstr "Ekspor & impor (TMX)"

#: src/Admin/Admin.php:1303
msgid "TMX is the standard translation-memory format. Export to back up your memory, move it to another TranslateRocket site, or open it in a CAT tool; import a TMX to load translations."
msgstr "TMX adalah format standar memori terjemahan. Ekspor untuk mencadangkan memori Anda, memindahkannya ke situs TranslateRocket lain, atau membukanya di alat CAT; impor TMX untuk memuat terjemahan."

#: src/Admin/Admin.php:1305
msgid "Export translation memory"
msgstr "Ekspor memori terjemahan"

#: src/Admin/Admin.php:1306
msgid "A standard TMX 1.4 file: one translation unit per source string, one segment per language."
