msgstr "%d baris dilewati karena bahasanya tidak dikonfigurasi sebagai bahasa tujuan di sini."

#: src/Admin/Admin.php:1201
msgid "This does not look like a Weglot export: the header has no word_from / word_to columns."
msgstr "Ini tidak tampak seperti ekspor Weglot: tajuknya tidak memiliki kolom word_from / word_to."

#: src/Admin/Admin.php:1203
msgid "The file is too large (10 MB maximum). Export from Weglot in smaller batches, e.g. one language at a time."
msgstr "File terlalu besar (maksimum 10 MB). Ekspor dari Weglot dalam bagian yang lebih kecil, misalnya satu bahasa per file."

