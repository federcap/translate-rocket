#. Plugin URI of the plugin
#: translate-rocket.php
msgid "https://translaterocket.com"
msgstr "https://translaterocket.com"

#. Description of the plugin
#: translate-rocket.php
msgid "Free, AI-powered translation for WordPress. Translate your whole site — visible text, image alt tags, titles, placeholders and SEO meta — using your own AI keys (OpenAI, Anthropic, Gemini, DeepL, Google). Untranslated strings are detected automatically as visitors browse."
msgstr "Terjemahan gratis bertenaga AI untuk WordPress. Terjemahkan seluruh situs Anda — teks yang terlihat, teks alt gambar, judul, placeholder, dan meta SEO — dengan kunci AI Anda sendiri (OpenAI, Anthropic, Gemini, DeepL, Google). Teks yang belum diterjemahkan terdeteksi otomatis saat pengunjung menjelajah."

#. Author of the plugin
