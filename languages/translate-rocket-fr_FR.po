msgstr "Les traductions de cette page ont été supprimées."

msgid "Page removed from the list."
msgstr "Page supprimée de la liste."

msgid "%1$d strings still to translate out of %2$d detected."
msgstr "%1$d chaînes encore à traduire sur %2$d détectées."

msgid "Scan site for text"
msgstr "Scanner le site pour le texte"

msgid "Automatically visits every published page to detect translatable text — no need to open them one by one."
msgstr "Visite automatiquement chaque page publiée pour détecter le texte traduisible — pas besoin de les ouvrir une par une."

msgid "No pages detected yet. Click “Scan site for text” above, or just browse your site as administrator."
msgstr "Aucune page détectée pour l'instant. Cliquez sur « Rechercher du texte sur le site » ci-dessus ou parcourez simplement votre site en tant qu'administrateur."

msgid "Search pages by name or slug… (spaces count as hyphens)"
msgstr "Rechercher des pages par nom ou slug… (les espaces comptent comme des tirets)"

msgid "Showing %1$s of %2$d pages"
msgstr "Affichage de %1$s sur %2$d pages"

