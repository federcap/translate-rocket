msgstr "rediriger vers la page d'accueil"

msgid "redirect to a custom URL"
msgstr "rediriger vers une URL personnalisée"

msgid "show a custom message"
msgstr "afficher un message personnalisé"

msgid "show a 404 (not found)"
msgstr "afficher un 404 (introuvable)"

