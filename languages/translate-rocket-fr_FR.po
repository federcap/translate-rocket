msgstr "Courir WordPress %s."

msgid "Database tables"
msgstr "Tables de base de données"

msgid "All TranslateRocket tables exist."
msgstr "Toutes les tables TranslateRocket existent."

msgid "Missing: %s. Deactivate and reactivate TranslateRocket to recreate them."
msgstr "Manquant : %s. Désactivez et réactivez TranslateRocket pour les recréer."

