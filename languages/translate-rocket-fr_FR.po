msgstr "N'affecte que l'arrière-plan : le drapeau et le texte restent entièrement visibles."

msgid "Placement"
msgstr "Placement"

msgid "Choose one: either place the switcher yourself with the shortcode / block, or let the plugin float it for you — not both."
msgstr "Choisissez-en un : soit placez le commutateur vous-même avec le shortcode/bloc, soit laissez le plugin le faire flotter pour vous – pas les deux."

msgid "Where to show the switcher"
msgstr "Où afficher le mélangeur"

msgid "Manual — I add it with the shortcode / block"
msgstr "Manuel — je l'ajoute avec le shortcode / block"

msgid "Floating — bottom right"
msgstr "Flottant – en bas à droite"

msgid "Floating — bottom left"
msgstr "Flottant – en bas à gauche"

