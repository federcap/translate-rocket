msgid "The summary in the X preview card."
msgstr "X 预览卡片中的摘要。"

msgid "Alt text of the shared image"
msgstr "分享图片的替代文字"

msgid "Describes the preview image for people using a screen reader."
msgstr "为使用屏幕阅读器的人描述预览图片。"

msgid "Alt text of the X image"
msgstr "X 图片的替代文字"

msgid "Describes the preview image on X."
msgstr "描述 X 上的预览图片。"

msgid "Site name in shares"
msgstr "分享中的网站名称"

