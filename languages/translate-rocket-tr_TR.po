msgstr[0] "%d sayfadan bağlantı veriliyor: bağlantı çevrilmiş sayfaya gidecek."
msgstr[1] "%d sayfadan bağlantı veriliyor: bağlantılar çevrilmiş sayfaya gidecek."

#: src/Admin/CopyCleanupAdmin.php
msgid "View"
msgstr "Görüntüle"

#: src/Admin/CopyCleanupAdmin.php
