msgid_plural "%1$d pages left by %2$s are still published in other languages"
msgstr[0] "%2$s tarafından bırakılan %1$d sayfa hâlâ başka bir dilde yayında"
msgstr[1] "%2$s tarafından bırakılan %1$d sayfa hâlâ diğer dillerde yayında"

#: src/Admin/CopyCleanupAdmin.php
