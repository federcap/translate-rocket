msgstr[1] "%d sayfa bu arada değiştiği için olduğu gibi bırakıldı — aşağıda kontrol edin."

#: src/Coexistence.php
msgid "%1$s and %2$s"
msgstr "%1$s ve %2$s"

#: src/Coexistence.php
