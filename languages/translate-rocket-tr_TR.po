#. Plugin URI of the plugin
#: translate-rocket.php
msgid "https://translaterocket.com"
msgstr "https://translaterocket.com"

#. Description of the plugin
#: translate-rocket.php
msgid "Free, AI-powered translation for WordPress. Translate your whole site — visible text, image alt tags, titles, placeholders and SEO meta — using your own AI keys (OpenAI, Anthropic, Gemini, DeepL, Google). Untranslated strings are detected automatically as visitors browse."
msgstr "WordPress için ücretsiz, yapay zekâ destekli çeviri. Sitenizin tamamını — görünen metinler, görsel alt etiketleri, başlıklar, yer tutucular ve SEO meta verileri — kendi yapay zekâ anahtarlarınızla (OpenAI, Anthropic, Gemini, DeepL, Google) çevirin. Çevrilmemiş metinler ziyaretçiler gezinirken otomatik olarak tespit edilir."

#. Author of the plugin
#: translate-rocket.php
msgid "federico_dev"
msgstr "federico_dev"

