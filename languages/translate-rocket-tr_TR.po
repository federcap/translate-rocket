msgstr "Güvenlik güncellemesi: %1$s %2$s."

#: src/Admin/UpdateNotice.php
#, php-format
msgid "%1$s %2$s is available."
msgstr "%1$s %2$s mevcut."

#: src/Admin/UpdateNotice.php
msgid "Please update now: it fixes a security problem."
msgstr "Lütfen şimdi güncelleyin: bir güvenlik sorununu düzeltir."

#: src/Admin/UpdateNotice.php
msgid "It takes a few seconds; your settings and translations stay as they are."
msgstr "Birkaç saniye sürer; ayarlarınız ve çevirileriniz olduğu gibi kalır."

#: src/Admin/UpdateNotice.php
msgid "Update now"
msgstr "Şimdi güncelle"

#: src/Admin/Admin.php
