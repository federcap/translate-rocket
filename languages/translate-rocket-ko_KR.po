msgstr "직접 배치할게요"

#. translators: %s: shortcode.
#: src/Admin/Admin.php:3324
#, php-format
msgid "Use the block “Language Switcher”, or the shortcode %s, wherever you like."
msgstr "“언어 전환기” 블록이나 숏코드 %s를 원하는 곳에 사용하세요."

#: src/Admin/Admin.php:3329
