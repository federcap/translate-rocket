#. translators: %d: number of rows skipped because their language is not configured.
#: src/Admin/Admin.php:1191
#, php-format
msgid "%d rows were skipped because their language is not configured as a target here."
msgstr "언어가 여기에서 대상 언어로 설정되지 않아 %d개 행을 건너뛰었습니다."

#: src/Admin/Admin.php:1201
msgid "This does not look like a Weglot export: the header has no word_from / word_to columns."
msgstr "Weglot 내보내기 파일이 아닌 것 같습니다: 헤더에 word_from / word_to 열이 없습니다."

#: src/Admin/Admin.php:1203
msgid "The file is too large (10 MB maximum). Export from Weglot in smaller batches, e.g. one language at a time."
msgstr "파일이 너무 큽니다(최대 10MB). Weglot에서 더 작게, 예를 들어 언어별로 나눠 내보내세요."

#: src/Admin/Admin.php:1205
msgid "Could not read the file. Please upload the .csv exported from your Weglot dashboard."
msgstr "파일을 읽을 수 없습니다. Weglot 대시보드에서 내보낸 .csv를 업로드하세요."

#: src/Admin/Admin.php:1211
msgid "Bring your translations over from another plugin — no need to start from scratch."
msgstr "다른 플러그인의 번역을 가져오세요 — 처음부터 시작할 필요가 없습니다."

#: src/Admin/Admin.php:1214
msgid "Existing TranslateRocket translations are kept; imported strings are added or filled in."
msgstr "기존 TranslateRocket 번역은 유지되며, 가져온 문자열은 추가되거나 빈 곳을 채웁니다."

