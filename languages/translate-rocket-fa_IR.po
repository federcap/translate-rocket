#: src/Admin/Admin.php:3260
#: src/Admin/MetaBox.php:107
#: src/Frontend/VisualEditor.php:162
msgid "Translation"
msgstr "ترجمه"

#: src/Admin/Admin.php:3267
msgid "What languages?"
msgstr "چه زبان‌هایی؟"

#: src/Admin/Admin.php:3268
msgid "Pick the language your site is written in, then the languages to translate it into."
msgstr "زبانی را که سایت شما به آن نوشته شده انتخاب کنید، سپس زبان‌هایی را که می‌خواهید به آن‌ها ترجمه شود."

#: src/Admin/Admin.php:3270
