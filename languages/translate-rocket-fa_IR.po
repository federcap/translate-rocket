msgstr "خطاها و هشدارهایی که TranslateRocket ثبت کرده، از جمله موارد مربوط به کارهای پس‌زمینه."

#: src/Admin/Admin.php:3080
msgid "Nothing to report — no issues logged."
msgstr "چیزی برای گزارش نیست — هیچ مشکلی ثبت نشده."

#: src/Admin/Admin.php:3085
msgid "When"
msgstr "زمان"

#: src/Admin/Admin.php:3086
msgid "Level"
msgstr "سطح"

#: src/Admin/Admin.php:3087
msgid "Area"
msgstr "بخش"

#: src/Admin/Admin.php:3088
