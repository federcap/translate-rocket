msgstr "کد"

#: src/Admin/Admin.php:3548
msgid "e.g. la"
msgstr "مثلاً la"

#: src/Admin/Admin.php:3551
msgid "Name"
msgstr "نام"

#: src/Admin/Admin.php:3552
