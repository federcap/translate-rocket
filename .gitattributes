# Normalise line endings: LF in the repository, native in the working copy.
* text=auto

*.php  text
*.js   text
*.css  text
*.txt  text
*.md   text
*.po   text
*.pot  text
*.svg  text
*.mo   binary
*.png  binary
*.jpg  binary

# Keep repository furniture out of the GitHub source archive.
.gitattributes    export-ignore
.gitignore        export-ignore
.wordpress-org/   export-ignore
COMPATIBILITY.md  export-ignore
